# Copy this file to .env.local and fill in your values.
# .env.local is gitignored — never commit real credentials.

# Neon — get this from your Neon project dashboard
DATABASE_URL=postgres://user:pass@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# Admin auth — use bcrypt to hash your password (e.g. https://bcrypt.online)
ADMIN_EMAIL=your-email@example.com
ADMIN_PASSWORD_HASH=$2a$10$...

# JWT — generate a random 64-char string (e.g. openssl rand -base64 64)
JWT_SECRET=your-random-secret-here

# Cloudinary — find these in your Cloudinary dashboard
VITE_CLOUDINARY_CLOUD_NAME=your-cloud-name
VITE_CLOUDINARY_UPLOAD_PRESET=portfolio-unsigned

# Web3Forms — get a free key at https://web3forms.com
VITE_WEB3FORMS_KEY=your-web3forms-access-key
